@page "/bible-reader"
@using BibleApp.Models
@using BibleApp.Services

<PageTitle>Bible Reader</PageTitle>

<MudPaper Elevation="0" Class="pa-6" Style="background: linear-gradient(135deg, #F5EDE4 0%, #EFE5DB 100%); min-height: 90vh;">
    <MudText Typo="Typo.h3" Align="Align.Center" Style="color: #5D4E37; font-weight: 600; margin-bottom: 32px;">
        Bible Reader
    </MudText>

    @if (isLoading)
    {
        <MudGrid Justify="Justify.Center">
            <MudItem xs="12">
                <MudPaper Elevation="0" Class="pa-8" Style="background: transparent; text-align: center;">
                    <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
                    <MudText Typo="Typo.h6" Style="color: #8B7355; margin-top: 16px;">
                        Loading Bible data...
                    </MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
    else
    {
    <MudGrid Justify="Justify.Center">
        <MudItem xs="12" sm="6">
                        <MudSelect T="string"
                                   Label="Translation"
                                   Placeholder="Translation"
                                   Variant="Variant.Outlined"
                                   Value="selectedTranslation"
                                   ValueChanged = "OnTranslationChanged"
                                   Style="background: #FFFFFF;"
                                   AdornmentIcon="@Icons.Material.Filled.MenuBook"
                                   AdornmentColor="Color.Primary"
                                   >
                            @foreach(var translation in translations)
                            {
                                <MudSelectItem Value ="@translation._id">@translation.translationName</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
        <MudItem xs="12" md="10" lg="8">
            <MudPaper Elevation="3" Class="pa-6" Style="background: #FFFFFF; border-radius: 12px;">
                <MudGrid Spacing="3">
                    <MudItem xs="12" sm="6">
                        <MudSelect T="Book"
                                   Label="Book"
                                   Variant="Variant.Outlined"
                                   Placeholder = "Book"
                                   Value="selectedBook"
                                   ValueChanged = "OnBookChanged"
                                   Style="background: #FFFFFF;"
                                   AdornmentIcon="@Icons.Material.Filled.Book"
                                   AdornmentColor="Color.Primary">
                            @foreach (var book in books)
                            {
                                <MudSelectItem Value="@book">@book.bookName</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSelect T="int"
                                   Label="Chapter"
                                   Placeholder="Chapter"
                                   Variant="Variant.Outlined"
                                   Value="selectedChapter"
                                   ValueChanged = "OnChapterChanged"
                                   Style="background: #FFFFFF;"
                                   AdornmentIcon="@Icons.Material.Filled.MenuBook"
                                   AdornmentColor="Color.Primary"
                                   Disabled="@(selectedBook is null)">
                            @for (int i = 1; i <= maxChapters; i++)
                            {
                                int chapterNumber = i; 
                                <MudSelectItem Value="@chapterNumber">Chapter @chapterNumber</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-6" Style="background: #D4B5A0;" />

                @if ((selectedBook is not null) && selectedChapter > 0)
                {
                    <MudPaper Elevation="0" Class="pa-4" Style="background: #FAF7F4; border-radius: 8px; border-left: 4px solid #C9A88E;">
                        <MudText Typo="Typo.h5" Style="color: #5D4E37; font-weight: 600; margin-bottom: 24px;">
                            @selectedBook.bookName - Chapter @selectedChapter
                        </MudText>

                        <MudText Typo="Typo.body1" Style="color: #3E3529; line-height: 1.8; font-size: 1.1rem;">
                            @bibleText
                        </MudText>
                    </MudPaper>
                }
                else
                {
                    <MudPaper Elevation="0" Class="pa-8" Style="background: #FAF7F4; border-radius: 8px;">
                        <MudText Typo="Typo.h6" Align="Align.Center" Style="color: #8B7355; font-style: italic;">
                            Select a book and chapter to begin reading
                        </MudText>
                    </MudPaper>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
    }
</MudPaper>

@inject HttpClient Http

@code {


    // define lists to hold initial data
    private BibleService reader = null!;
    private List<Book> books = new();
    private List<Chapter> chapters = new List<Chapter>();
    private List<Translation> translations = new List<Translation>();
    private Book? selectedBook = null;
    private int selectedChapter = 0;
    private int maxChapters = 50; // Default, will be updated based on book selection
    private string bibleText = string.Empty;
    private string selectedTranslation = "KJV";
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        // instance of Bible service to get books
        reader = new BibleService(Http);

        var BooksTask = reader.GetBooksAsync();
        var TranslationsTask = reader.GetTranslationsAsync();
        var ChaptersTask = reader.GetAllChaptersAsync();

        await Task.WhenAll(BooksTask, TranslationsTask, ChaptersTask);

        books = BooksTask.Result;
        translations = TranslationsTask.Result;
        isLoading = false;
    }       

    private void OnBookChanged(Book? newBook)
    {
        selectedBook = newBook;
        selectedChapter = 0;
        bibleText = string.Empty; // Clear text when book changes

        if(selectedBook is not null)
        {
            maxChapters = selectedBook.chapterCount;
        }
        else
        {
            maxChapters = 0;
        }

    }

    private async Task OnChapterChanged(int newChapter)
    {
        selectedChapter = newChapter; 

        if (selectedBook is not null && newChapter != 0)
        {
            await LoadBibleTextAsync(); 
        }
    }    

    private async Task OnTranslationChanged(string newTranslation)
    {
        selectedTranslation = newTranslation; 
        
        // keep current Bible text but update to new translation 
        if(selectedBook is not null && selectedChapter > 0)
        {
            await LoadBibleTextAsync(); 
        }
    }

    private async Task LoadBibleTextAsync()
    {
        if (selectedBook is null || selectedChapter <= 0)
        {
            bibleText = string.Empty;
            return;
        }

        try
        {
            var chapter = await reader.GetChapterAsync(selectedBook._id, selectedChapter, selectedTranslation);

            if (chapter is not null && chapter.verses.Any())
            {
                // Format verses as "1 In the beginning... 2 And the earth..."
                bibleText = string.Join(" ", chapter.verses.Select(v => $"{v.verseNo} {v.verseText}"));
            }
            else
            {
                bibleText = "Chapter not found.";
            }
        }
        catch (Exception ex)
        {
            bibleText = $"Error loading chapter: {ex.Message}";
        }
    }

    // TODO: implement clear button 
    private void Clear()
    {
        selectedBook = null; 
        selectedChapter = 0; 
        maxChapters = 0; 
        bibleText = string.Empty; 
        selectedTranslation = "KJV"; 
    }

}
