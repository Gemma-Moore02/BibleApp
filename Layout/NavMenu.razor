<MudAppBar Elevation="2" Style="background: linear-gradient(135deg, #D4B5A0 0%, #C9A88E 100%); color: #5D4E37;">
    <MudIconButton Icon="@Icons.Material.Filled.MenuBook"
                   Color="Color.Inherit"
                   Edge="Edge.Start"
                   Style="margin-right: 16px;" />
    <MudText Typo="Typo.h5" Style="font-weight: 600; letter-spacing: 0.5px;">
        Bible
    </MudText>
    <MudSpacer />
    <MudButton Href="/"
               Variant="Variant.Text"
               StartIcon="@Icons.Material.Filled.Home"
               Style="color: #5D4E37; text-transform: none; font-weight: 500;">
        Home
    </MudButton>
    <MudButton Href="/bible-reader"
               Variant="Variant.Text"
               StartIcon="@Icons.Material.Filled.Book"
               Style="color: #5D4E37; text-transform: none; font-weight: 500;">
        Bible Reader
    </MudButton>    
</MudAppBar>

@code {
    // MudBlazor AppBar handles responsive behavior automatically
}
